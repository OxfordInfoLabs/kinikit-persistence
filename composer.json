{
  "name": "oxil/kinikit-persistence",
  "version": "0.0.1",
  "description": "Kinikit - PHP Application development framework",
  "keywords": [
    "PHP",
    "application",
    "mvc",
    "json webservices",
    "webservices",
    "orm",
    "persistence framework"
  ],
  "homepage": "https://kinikit.com",
  "type": "library",
  "require": {
    "oxil/kinikit-core": "dev-master",
    "google/cloud-bigquery": "^1.38.0",
    "google/cloud-spanner": "^2.8.0"
  },
  "minimum-stability": "dev",
  "require-dev": {
    "phpunit/phpunit": "^9"
  },
  "scripts": {
    "dev": "rm -rf vendor/oxil/kini*; ln -s ../../../../kinikit/kinikit-core vendor/oxil/kinikit-core;"
  },
  "autoload": {
    "psr-4": {
      "Kinikit\\Persistence\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  }
}
